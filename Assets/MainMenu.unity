  - day: 6
    rewardType: 0
    amount: 150
    title: "150 \u043C\u043E\u043D\u0435\u0442"
    description: "\u041F\u0440\u0435\u043C\u0438\u0430\u043B\u044C\u043D\u0430\u044F
      \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u0430\u044F \u043D\u0430\u0433\u0440\u0430\u0434\u0430."
