    amount: 50
    title: "50 \u043C\u043E\u043D\u0435\u0442"
    description: "\u041C\u043E\u043D\u0435\u0442\u044B \u043F\u0440\u0438\u0433\u043E\u0434\u044F\u0442\u0441\u044F
      \u0434\u043B\u044F \u0431\u0443\u0434\u0443\u0449\u0438\u0445 \u043F\u043E\u043A\u0443\u043F\u043E\u043A."
  - day: 2
    rewardType: 0
    amount: 75
    title: "75 \u043C\u043E\u043D\u0435\u0442"
    description: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0435\u0436\u0435\u0434\u043D\u0435\u0432\u043D\u044B\u0439
      \u0437\u0430\u043F\u0430\u0441 \u043C\u043E\u043D\u0435\u0442."
  - day: 3
    rewardType: 1
    amount: 1
    title: "1 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430"
    description: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443,
      \u0435\u0441\u043B\u0438 \u0437\u0430\u0441\u0442\u0440\u044F\u043B \u043D\u0430
      \u0443\u0440\u043E\u0432\u043D\u0435."
  - day: 4
    rewardType: 0
    amount: 100
    title: "100 \u043C\u043E\u043D\u0435\u0442"
    description: "\u0411\u043E\u043B\u044C\u0448\u0435 \u043C\u043E\u043D\u0435\u0442
      \u0434\u043B\u044F \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0433\u043E
      \u0441\u0442\u0430\u0440\u0442\u0430."
  - day: 5
    rewardType: 2
    amount: 5
    title: "+5 \u0445\u043E\u0434\u043E\u0432"
    description: "\u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0445\u043E\u0434\u044B \u043F\u043E\u043C\u043E\u0433\u0443\u0442 \u0434\u043E\u0436\u0430\u0442\u044C
